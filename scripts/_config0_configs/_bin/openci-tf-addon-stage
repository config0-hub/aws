STAGES = (
    "token", "register", "record",
    "openci_tf_deploy", "ecr_image", "ecr_repository",
)

# Byte-identical to config0_cli.gitops.records (ADDON_RESOURCE_TYPES,
# addon_resource_record_id) - pinned by pkg-config0-cli:parity + its test.
ADDON = "openci_tf"
ADDON_ID = hashlib.md5(b"addon:openci_tf").hexdigest()
ADDON_RESOURCE_TYPES = (
    "github_webhook",
    "settings_item",
    "openci_tf_deploy",
    "ecr_image",
    "ecr_repository",
    "ssm_parameter",
)


def addon_resource_record_id(addon_id, resource_type, key):
    """``md5("addon_resource:" + addon_id + ":" + resource_type + ":" + key)``."""
    if not addon_id or not key:
        raise ValueError("addon_resource_record_id needs addon_id and key")
    if resource_type not in ADDON_RESOURCE_TYPES:
        raise ValueError(
            f"addon resource_type {resource_type!r} is not one of {ADDON_RESOURCE_TYPES}"
        )
    return hashlib.md5(
        f"addon_resource:{addon_id}:{resource_type}:{key}".encode()
    ).hexdigest()

_COMMIT_SHA = re.compile(r"[0-9a-f]{40}")


def _github_owner_repo(repo_url):
    """owner, repo of a https://github.com/<owner>/<repo>[.git] clone URL."""
    parsed = urlparse(repo_url)
    if parsed.scheme != "https" or parsed.netloc != "github.com":
        raise ValueError(f"OPENCI_TF_REPO_URL must be a https://github.com URL, got {repo_url!r}")
    owner, _, repo = parsed.path.strip("/").partition("/")
    repo = repo.removesuffix(".git")
    if not owner or not repo or "/" in repo:
        raise ValueError(f"OPENCI_TF_REPO_URL must name <owner>/<repo>, got {repo_url!r}")
    return owner, repo


def _normalize_hook_url(url):
    """Collapse doubled path slashes so a hook written by an older release
    (which joined the webhook URL as ``//webhook``) still matches."""
    if not isinstance(url, str):
        return ""
    return re.sub(r"(?<!:)/{2,}", "/", url).rstrip("/")


def _github_stored_webhook_url(webhook_url):
    """The config.url register_repo.py POSTs: bare deploy output + trigger id."""
    return f"{webhook_url.rstrip('/')}/{os.environ['TRIGGER_ID']}"


def fetch_pinned_source(repo_url, git_ref, dest_root, urlopen=urllib.request.urlopen):
    """Download the repository tree at exactly ``git_ref`` without git.

    GitHub serves ``git archive`` tarballs at codeload for a commit sha. The
    archive's pax global header ``comment`` is the archived commit id and its
    single top-level directory is ``<repo>-<sha>``, so the pin is verified
    from the archive content, not from the URL that was asked for. A sha
    GitHub does not know is a 404: the HTTPError propagates.

    Returns the extracted source directory.
    """
    if not _COMMIT_SHA.fullmatch(git_ref):
        raise ValueError(f"OPENCI_TF_GIT_REF must be a 40-char commit sha, got {git_ref!r}")
    owner, repo = _github_owner_repo(repo_url)
    url = f"https://codeload.github.com/{owner}/{repo}/tar.gz/{git_ref}"
    archive_path = os.path.join(dest_root, f"{repo}-{git_ref}.tar.gz")
    with urlopen(url, timeout=120) as src, open(archive_path, "wb") as out:
        shutil.copyfileobj(src, out)
    top = f"{repo}-{git_ref}"
    with tarfile.open(archive_path) as archive:
        archived = archive.pax_headers.get("comment")
        if archived != git_ref:
            raise ValueError(
                f"{url} archived commit {archived!r} does not match the pinned {git_ref}"
            )
        roots = {member.name.split("/", 1)[0] for member in archive.getmembers()}
        if roots != {top}:
            raise ValueError(f"{url} top-level entries {sorted(roots)} != [{top!r}]")
        archive.extractall(dest_root, filter="data")
    os.remove(archive_path)
    return os.path.join(dest_root, top)


class OpenciTfAddonStage(ResourceCmdHelper):
    """Run one openci-tf config0-addon install/removal stage."""

    def __init__(self):
        super().__init__()
        self.classname = "OpenciTfAddonStage"
        self.logger = Config0Logger(self.classname, logcategory="cloudprovider")

        self.stage = os.environ["STAGE"]
        if self.stage not in STAGES:
            raise ValueError(f'STAGE "{self.stage}" not supported; expected one of {STAGES}')
        self.method = os.environ.get("METHOD", "create")
        if self.method not in ("create", "destroy"):
            raise ValueError(f'METHOD "{self.method}" not supported; expected create|destroy')

        self.region = os.environ["OPENCI_TF_REGION"]
        # Same semantics as openci-tf-addon-tofu.py env(): missing OR empty is
        # a broken order, never a silent default (an empty value once built the
        # SSM path /openci-tf/install//config0_outputs).
        self.project_name = os.environ.get("OPENCI_TF_PROJECT")
        if not self.project_name:
            raise KeyError("OPENCI_TF_PROJECT is required")
        self.install_ssm_prefix = f"/openci-tf/install/{self.project_name}"
        self._checkout = None

        self.ssm = boto3.client("ssm", region_name=self.region)
        self.dynamodb = boto3.client("dynamodb", region_name=self.region)

    # -- openci-tf checkout ------------------------------------------------

    def checkout(self):
        """Fetch the pinned openci-tf source once; return its directory."""
        if self._checkout:
            return self._checkout
        self._checkout = fetch_pinned_source(
            os.environ["OPENCI_TF_REPO_URL"],
            os.environ["OPENCI_TF_GIT_REF"],
            OnDiskTmpDir().get(),
        )
        return self._checkout

    # -- SSM install namespace --------------------------------------------

    def _ssm_get(self, name, decrypt=False):
        return self.ssm.get_parameter(Name=name, WithDecryption=decrypt)["Parameter"]["Value"]

    def _ssm_delete(self, name):
        try:
            self.ssm.delete_parameter(Name=name)
            self.logger.debug(f"deleted SSM parameter {name}")
        except self.ssm.exceptions.ParameterNotFound:
            self.logger.debug(f"SSM parameter {name} already absent")

    def _ssm_optional(self, name, decrypt=False):
        try:
            return self._ssm_get(name, decrypt=decrypt)
        except self.ssm.exceptions.ParameterNotFound:
            return None

    def _deploy_outputs(self):
        return json.loads(self._ssm_get(f"{self.install_ssm_prefix}/config0_outputs"))

    def _hook_id(self, *, optional=False):
        """The GitHub webhook hook id register_repo.py recorded in SSM.

        register_repo.py stores it as a SecureString, so the read MUST decrypt:
        an undecrypted read returns the KMS ciphertext blob, which then lands in
        the addon record and makes the destroy-side hook DELETE hit a 404 that
        looks like "already absent" while the real hook leaks.
        """
        name = f"{self.install_ssm_prefix}/webhook_hook_id"
        if optional:
            value = self._ssm_optional(name, decrypt=True)
            if value is None:
                return None
        else:
            value = self._ssm_get(name, decrypt=True)
        if not re.fullmatch(r"[0-9]+", value):
            raise ValueError(
                f"SSM {name} is not a plain GitHub hook id (got {value[:12]!r}...)"
            )
        return value

    # -- add-on resource rows -----------------------------------------------

    def _qhost(self):
        return (
            os.environ["QHOST_URL"].rstrip("/"),
            {"Authorization": f"Bearer {os.environ['QHOST_JWT_TOKEN']}"},
        )

    def _put_row(self, resource_type, key, name, **fields):
        """Write one typed add-on resource row (idempotent QHost upsert).

        Stamped with addon_id and the run identity (project_id / schedule_id /
        run_id from the worker-exported run environment - the QHost run-context
        write guard rejects a run write without them).

        No region: every row this method writes (ssm_parameter, github_webhook,
        settings_item) is a region-less thing, so it does not stamp the Lambda's
        region (user decision 2026-09-06: region is NOT required on a resource
        row). The parent addon record carries region; those region-ful rows are
        written by create_record / the install stack, not here.
        """
        values = {
            "_id": addon_resource_record_id(ADDON_ID, resource_type, key),
            "resource_type": resource_type,
            "addon_id": ADDON_ID,
            "addon": ADDON,
            "name": name,
            "provider": "openci-tf",
        }
        values.update(fields)
        stamp_run_identity(values, env=os.environ)
        url, headers = self._qhost()
        response = requests.put(
            f"{url}/api/v1/resources",
            headers=headers,
            json={"_id": values["_id"], "resource_type": resource_type, "data": values},
            timeout=30,
        )
        response.raise_for_status()
        print(f"recorded {resource_type} row {values['_id']} ({name})")
        return values

    def _rows(self, resource_type):
        """The add-on's rows of one type - the QUERY that decides what to delete."""
        url, headers = self._qhost()
        response = requests.get(
            f"{url}/api/v1/resources",
            headers=headers,
            params={"match": json.dumps({"addon_id": ADDON_ID, "resource_type": resource_type})},
            timeout=30,
        )
        response.raise_for_status()
        rows = response.json()["data"]
        if not isinstance(rows, list):
            raise TypeError("QHost resources response data must be a list")
        return [row.get("data") or {} for row in rows]

    def _delete_row(self, data):
        url, headers = self._qhost()
        row_id = data["_id"]
        response = requests.delete(
            f"{url}/api/v1/resources/{urllib.parse.quote(str(row_id), safe='')}",
            headers=headers,
            timeout=30,
        )
        response.raise_for_status()
        deleted = response.json()["data"]["deleted"]
        if deleted != 1:
            raise ValueError(
                f"deleting {data.get('resource_type')} row {row_id} removed "
                f"{deleted} rows, expected exactly 1"
            )
        print(f"deleted {data.get('resource_type')} row {row_id}")

    # -- stages: create ----------------------------------------------------

    def create_token(self):
        # The token arrives through the encrypted run environment, never through
        # the persisted order params. The execgroup runtime carries and reseals
        # that in-memory environment for this stage.
        token = os.environ["GITOPS_TOKEN"]
        if not token:
            raise ValueError("GITOPS_TOKEN is empty")
        path = os.environ["CLONE_TOKEN_SSM_PATH"]
        # Row-first (finding M3): record the cleanup-identity row BEFORE the SSM
        # parameter exists, so a QHost failure after put_parameter still leaves a
        # discoverable row. put_parameter(Overwrite=True) is idempotent, so a
        # retry finds the row present (upsert) and rewrites the same parameter.
        self._put_row(
            "ssm_parameter", path, "openci-tf clone token",
            parameter_name=path, purpose="clone_token",
        )
        self.ssm.put_parameter(
            Name=path,
            Value=token,
            Type="SecureString",
            Overwrite=True,
        )
        print(f"clone token written to SSM {path}")

    def create_register(self):
        checkout = self.checkout()
        outputs = self._deploy_outputs()
        repo = os.environ["GITOPS_REPO"]
        bare_webhook_url = outputs["webhook_url"]
        stored_webhook_url = _github_stored_webhook_url(bare_webhook_url)
        table = outputs["settings_table_name"]
        # Row-first (finding M3): every cleanup-identity row register_repo.py's
        # things map to is written BEFORE register_repo.py creates them, so a
        # QHost write failure after a provider success still leaves a
        # discoverable row and a retry converges. The webhook keys on the
        # config.url register_repo.py POSTs (bare deploy webhook_url +
        # TRIGGER_ID; its hook id is unknown until the POST; _record_registration
        # fills it in after); register_repo.py (re)creates the settings items and
        # the SSM parameters idempotently on their key.
        self._put_row(
            "github_webhook", f"{repo}#{stored_webhook_url}", f"openci-tf webhook on {repo}",
            github_repo=repo, webhook_url=stored_webhook_url,
        )
        for pk, sk in (("repo", os.environ["TRIGGER_ID"]),
                       ("account", os.environ["ACCOUNT_ALIAS"])):
            self._put_row(
                "settings_item", f"{table}/{pk}/{sk}", f"openci-tf settings {pk}/{sk}",
                table_name=table, pk=pk, sk=sk,
            )
        for suffix in ("webhook_secret", "webhook_hook_id"):
            name = f"{self.install_ssm_prefix}/{suffix}"
            self._put_row(
                "ssm_parameter", name, f"openci-tf {suffix}",
                parameter_name=name, purpose=suffix,
            )
        # The pinned runtime download URLs come from the checkout itself, so
        # registration always matches the installed openci-tf version.
        completed = subprocess.run(
            [
                sys.executable, "-c",
                "import json; from src.domain.cmd_builder.installers import "
                "PINNED_UPSTREAM_URLS; print(json.dumps(PINNED_UPSTREAM_URLS))",
            ],
            cwd=checkout, check=True, capture_output=True, text=True,
        )
        argv = [
            sys.executable, "install/register_repo.py",
            "--repo", os.environ["GITOPS_REPO"],
            "--trigger-id", os.environ["TRIGGER_ID"],
            "--account-alias", os.environ["ACCOUNT_ALIAS"],
            "--webhook-url", bare_webhook_url,
            "--github-token-ssm", os.environ["CLONE_TOKEN_SSM_PATH"],
            "--upstream-urls-json", completed.stdout.strip(),
            "--region", self.region,
            "--project-name", self.project_name,
        ]
        subprocess.run(argv, cwd=checkout, check=True)
        self._record_registration()

    def _record_registration(self):
        """Confirm register_repo.py created what its row-first receipts promised,
        then fill the webhook row's hook id in.

        create_register wrote the github_webhook / settings_item / ssm_parameter
        rows BEFORE register_repo.py ran. Here, after it ran, fail loud if any
        thing is missing (a register_repo.py that exited 0 without doing its job
        is broken), then rewrite the webhook row with the decrypted hook id that
        was only known after the POST (same deterministic id, keyed on the
        callback URL)."""
        outputs = self._deploy_outputs()
        table = outputs["settings_table_name"]
        for pk, sk in (("repo", os.environ["TRIGGER_ID"]),
                       ("account", os.environ["ACCOUNT_ALIAS"])):
            key = {"pk": {"S": pk}, "sk": {"S": sk}}
            if not self.dynamodb.get_item(TableName=table, Key=key).get("Item"):
                raise ValueError(
                    f"register_repo.py left no {pk}/{sk} item in {table}"
                )
        for suffix in ("webhook_secret", "webhook_hook_id"):
            name = f"{self.install_ssm_prefix}/{suffix}"
            if self._ssm_optional(name, decrypt=True) is None:
                raise ValueError(f"register_repo.py left no SSM parameter {name}")
        repo = os.environ["GITOPS_REPO"]
        stored_webhook_url = _github_stored_webhook_url(outputs["webhook_url"])
        self._put_row(
            "github_webhook", f"{repo}#{stored_webhook_url}",
            f"openci-tf webhook on {repo}",
            github_repo=repo, webhook_url=stored_webhook_url, hook_id=self._hook_id(),
        )

    def create_record(self):
        outputs = self._deploy_outputs()
        hook_id = self._hook_id()
        # Identity per the config0_cli addon-record builder: one per account,
        # no region, _id = md5("addon:openci_tf"). The engine runs on
        # config0_publisher only, so the recipe is applied here directly.
        #
        # Project-dispatch identity contract (saas-api
        # projectlib/gitops.py ADDON_IDENTITY_FIELDS, tested against the shared
        # openci-tf-addon-record-seam.vectors.json): `owner` is the GitHub
        # owner, `repo` is the BARE repo path segment (both are verbatim
        # decision-26 state-key segments), `account_alias` is the tenant hub
        # account's alias. GitHub API calls need the full identity, kept
        # separately as `github_repo` = "owner/repo".
        github_repo = os.environ["GITOPS_REPO"]
        gh_owner, _, gh_repo = github_repo.partition("/")
        if not gh_owner or not gh_repo:
            raise ValueError(
                f'GITOPS_REPO "{github_repo}" is not an owner/repo identity'
            )
        account_alias = os.environ["ACCOUNT_ALIAS"]
        if not account_alias:
            raise ValueError("ACCOUNT_ALIAS is empty")
        resource = {
            "_id": ADDON_ID,
            "resource_type": "addon",
            # The parent row carries its own id as addon_id, so the ONE query
            # (addon_id == ADDON_ID) finds the parent and every child row.
            "addon_id": ADDON_ID,
            "provider": "openci-tf",
            "source_method": "shellout",
            "name": f"openci-tf-{os.environ.get('INSTALL_NAME', 'main')}",
            "addon": "openci_tf",
            "attempt_id": os.environ["ATTEMPT_ID"],
            "owner": gh_owner,
            "repo": gh_repo,
            "github_repo": github_repo,
            "account_alias": account_alias,
            "trigger_id": os.environ["TRIGGER_ID"],
            "webhook_hook_id": hook_id,
            "clone_token_ssm_path": os.environ["CLONE_TOKEN_SSM_PATH"],
            "region": self.region,
            # Convergent producer: an install re-POST over an INSTALLED add-on
            # must land on the SAME deterministic _id with the new attempt_id
            # (one addon record per account). The execgroup write-back guard
            # (config0_cli _record_resource must_be_zero) would refuse the prior
            # COMPLETED install's confirmed row; `overide` declares this write
            # as the upsert it is. The CLI strips the flag before the PUT.
            "overide": True,
        }
        resource.update(outputs)
        insert_resource_id(resource)
        self.write_resource_to_json_file(resource)
        print("addon record written (deploy outputs + registration values + attempt_id)")

    # -- stages: destroy ---------------------------------------------------

    def destroy_token(self):
        """Delete every ssm_parameter row's parameter - the LAST destroy stage
        (the clone token is one of them; every earlier stage may read it)."""
        rows = self._rows("ssm_parameter")
        if not rows:
            print("no ssm_parameter rows - nothing to delete")
        for data in rows:
            self._ssm_delete(data["parameter_name"])
            self._delete_row(data)
        print("SSM parameters deleted")

    def _qhost_resources(self, resource_type):
        url, headers = self._qhost()
        response = requests.get(
            f"{url}/api/v1/resources",
            headers=headers,
            params={"resource_type": resource_type},
            timeout=30,
        )
        response.raise_for_status()
        rows = response.json()["data"]
        if not isinstance(rows, list):
            raise TypeError("QHost resources response data must be a list")
        return rows

    def _pipeline_pr_numbers(self, repo):
        # The write-back PR is recorded on the repo's pipeline row; the dedicated
        # mutation PRs are recorded on pipeline_run rows. Enumerate the latter by
        # this install's TRIGGER_ID - stamped on every pipeline_run row by the
        # saas-api dispatcher (build_pipeline_run_values) - NOT by a project_id
        # derived from surviving pipeline rows: that derivation missed every
        # mutation PR when the project was removed before the add-on and no
        # pipeline row remained (defect 44).
        #
        # This covers the add-on-first ordering, where the pipeline and
        # pipeline_run rows are still present. In the project-first ordering both
        # carriers are already gone by the time this stage runs: `config0 project
        # delete` deletes the pipeline row, and run_complete's completed-destroy
        # sweep deletes EVERY resource row with data.project_id = the project,
        # pipeline_run rows included (config0-qhost routes/schedules/crud.py,
        # DELETE ... WHERE data->>'project_id' = %s). That ordering closes these
        # PRs at the config0_cli layer instead (handlers/project.py
        # _close_gitops_prs), while the add-on's clone token still exists.
        trigger_id = os.environ["TRIGGER_ID"]
        pipelines = [
            row.get("data") or {}
            for row in self._qhost_resources("pipeline")
            if (row.get("data") or {}).get("repo") == repo
        ]
        pipeline_runs = [
            row.get("data") or {}
            for row in self._qhost_resources("pipeline_run")
            if str((row.get("data") or {}).get("trigger_id") or "") == trigger_id
        ]
        return {
            int(data["pr_number"])
            for data in [*pipelines, *pipeline_runs]
            if int(data.get("pr_number") or 0) > 0
        }

    def _close_pipeline_prs(self, repo, token, pr_numbers):
        for pr_number in sorted(pr_numbers):
            response = requests.patch(
                f"https://api.github.com/repos/{repo}/pulls/{pr_number}",
                headers={
                    "Authorization": f"Bearer {token}",
                    "Accept": "application/vnd.github+json",
                    "X-GitHub-Api-Version": "2022-11-28",
                },
                json={"state": "closed"},
                timeout=30,
            )
            response.raise_for_status()
            print(f"closed GitHub PR #{pr_number} on {repo}")

    def _delete_webhook(self, repo, hook_id, token):
        import urllib.error

        request = urllib.request.Request(
            f"https://api.github.com/repos/{repo}/hooks/{hook_id}",
            method="DELETE",
            headers={
                "Authorization": f"Bearer {token}",
                "Accept": "application/vnd.github+json",
            },
        )
        try:
            urllib.request.urlopen(request)
            print(f"deleted GitHub webhook {hook_id} on {repo}")
        except urllib.error.HTTPError as error:
            if error.code != 404:
                raise
            print(f"GitHub webhook {hook_id} on {repo} already absent")

    def _hooks_matching_url(self, repo, webhook_url, token):
        """The repo's hook ids whose config url is the stored webhook URL - the
        same config.url register_repo.py POSTed (bare deploy webhook_url +
        TRIGGER_ID). Used to delete a webhook whose row never recorded its hook
        id (an install that failed after the POST): the stored URL is the
        natural key we control, so a retry's duplicate hook is discoverable and
        none-found is a no-op."""
        # ponytail: per_page=100 (not paginated); an install repo carries one
        # openci-tf hook - a page loop only matters past 100 webhooks on one repo.
        response = requests.get(
            f"https://api.github.com/repos/{repo}/hooks",
            headers={
                "Authorization": f"Bearer {token}",
                "Accept": "application/vnd.github+json",
                "X-GitHub-Api-Version": "2022-11-28",
            },
            params={"per_page": 100},
            timeout=30,
        )
        response.raise_for_status()
        hooks = response.json()
        if len(hooks) >= 100:
            raise RuntimeError(f"{repo} has 100+ webhooks; hook listing is not authoritative")
        wanted = _normalize_hook_url(webhook_url)
        matches = []
        for hook in hooks:
            hook_url = (hook.get("config") or {}).get("url")
            if hook_url == webhook_url:
                matches.append(str(hook["id"]))
            elif _normalize_hook_url(hook_url) == wanted:
                matches.append(str(hook["id"]))
        return matches

    def destroy_register(self):
        """github_webhook rows: close the recorded PRs, delete each webhook;
        settings_item rows: delete each item. Rows go once their thing is gone."""
        webhooks = self._rows("github_webhook")
        settings = self._rows("settings_item")
        if not webhooks and not settings:
            print("no github_webhook or settings_item rows - registration already removed")
            return

        if webhooks:
            token = self._ssm_optional(os.environ["CLONE_TOKEN_SSM_PATH"], decrypt=True)
            if token is None:
                raise ValueError(
                    "clone token is missing while github_webhook rows remain; "
                    "refusing to skip GitHub cleanup"
                )
            # PRs must close while the token still exists. This includes the
            # write-back PRs on pipeline rows and dedicated mutation PRs on
            # pipeline_run rows.
            for repo in sorted({data["github_repo"] for data in webhooks}):
                self._close_pipeline_prs(repo, token, self._pipeline_pr_numbers(repo))
            for data in webhooks:
                repo = data["github_repo"]
                hook_id = data.get("hook_id")
                if hook_id:
                    self._delete_webhook(repo, hook_id, token)
                else:
                    # A row-first receipt whose install failed before its hook
                    # id was recorded (finding M3): find the hook by the callback
                    # URL the row carries and delete it. None found = exit 0.
                    matches = self._hooks_matching_url(repo, data["webhook_url"], token)
                    if not matches:
                        print(
                            f"no GitHub webhook on {repo} with callback "
                            f"{data['webhook_url']} - already absent"
                        )
                    for match in matches:
                        self._delete_webhook(repo, match, token)
                self._delete_row(data)

        for data in settings:
            self.dynamodb.delete_item(
                TableName=data["table_name"],
                Key={"pk": {"S": data["pk"]}, "sk": {"S": data["sk"]}},
            )
            print(f"deleted settings item {data['pk']}/{data['sk']} in {data['table_name']}")
            self._delete_row(data)

    # The three CodeBuild-created things are destroyed by their own CodeBuild
    # destroy orders (openci-tf-addon-tofu, openci-tf-image-copy), which run in
    # the engine without QHost access. The row for each is deleted HERE, in the
    # Lambda-side order the destroy stack places right after the CodeBuild
    # order. That CodeBuild order had to succeed for this one to run (the stack
    # sequences them, must_succeed by default), and it destroys through the same
    # provider that created the thing - its exit 0 IS the confirmation the thing
    # is gone, so this stage just deletes the row. No separate re-check.

    def destroy_openci_tf_deploy(self):
        for data in self._rows("openci_tf_deploy"):
            self._delete_row(data)

    def destroy_ecr_image(self):
        for data in self._rows("ecr_image"):
            self._delete_row(data)

    def destroy_ecr_repository(self):
        for data in self._rows("ecr_repository"):
            self._delete_row(data)

    # -- entrypoint --------------------------------------------------------

    def _write_destroy_evidence(self):
        """Write this side-effect stage's successful teardown receipt.

        These stages do not own the generic resource row or its state pointer.
        Their method returns only after every recorded row of the stage's type
        is dealt with (its external thing removed - by this stage's own API call
        or by the CodeBuild destroy order that had to succeed before it - and
        the row deleted), so a successful command is the stage-local
        zero-remaining contract consumed by the generic remove handler.
        """
        trigger_id = os.environ.get("QUEUE_ID") or os.environ.get("RUN_ID")
        if not trigger_id:
            raise ValueError("destroy evidence requires QUEUE_ID or RUN_ID")
        marker = (
            "CONFIG0_DESTROY_PRE_STATE_COUNT=0\n"
            "CONFIG0_DESTROY_POST_STATE_COUNT=0"
        )
        self.write_resource_to_json_file(
            {
                "status": True,
                "execution_result": {
                    "trigger_id": trigger_id,
                    "status": "succeeded",
                    "steps": [{"output": marker}],
                },
            }
        )

    def run(self):
        method_name = f"{self.method}_{self.stage}"
        print(f"openci-tf addon stage={self.stage} method={self.method}")
        getattr(self, method_name)()
        if self.method == "destroy":
            self._write_destroy_evidence()
        print(f"openci-tf addon stage={self.stage} method={self.method} complete")


if __name__ == "__main__":
    main = OpenciTfAddonStage()
    main.run()
