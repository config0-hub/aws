{
  "Comment": "ssm_ec2_exec_eventbridge — invoke the starter Lambda with waitForTaskToken, which fires an SSM command and stores the token server-side. The token is released later by the callback Lambda (EventBridge SSM status event) or the fallback Lambda (scheduled reconcile), not by the EC2 box.",
  "StartAt": "ApplyDefaults",
  "States": {
    "ApplyDefaults": {
      "Type": "Pass",
      "Parameters": {
        "input.$": "$",
        "defaults": {
          "timeout_seconds": 3600
        }
      },
      "Next": "Merge"
    },
    "Merge": {
      "Type": "Pass",
      "Parameters": {
        "merged.$": "States.JsonMerge($.defaults, $.input, false)"
      },
      "Next": "ComputeCallbackTimeout"
    },
    "ComputeCallbackTimeout": {
      "Type": "Pass",
      "Comment": "Callback bound (ASL Task TimeoutSecondsPath) = requested execution timeout + 120s grace. On timeout the state machine checks the command before deciding its outcome.",
      "Parameters": {
        "merged": {
          "instance_id.$": "$.merged.instance_id",
          "script.$": "$.merged.script",
          "timeout_seconds.$": "$.merged.timeout_seconds",
          "callback_timeout_seconds.$": "States.MathAdd($.merged.timeout_seconds, 120)"
        }
      },
      "Next": "InvokeStarter"
    },
    "InvokeStarter": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${starter_function_arn}",
        "Payload": {
          "TaskToken.$": "$$.Task.Token",
          "executionArn.$": "$$.Execution.Id",
          "instance_id.$": "$.merged.instance_id",
          "script.$": "$.merged.script",
          "timeout_seconds.$": "$.merged.timeout_seconds"
        }
      },
      "TimeoutSecondsPath": "$.merged.callback_timeout_seconds",
      "ResultPath": "$.callback",
      "Catch": [
        {
          "ErrorEquals": ["States.Timeout"],
          "ResultPath": "$.callback_timeout",
          "Next": "GetCommandMapping"
        }
      ],
      "Next": "IsSuccess"
    },
    "GetCommandMapping": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:getItem",
      "Parameters": {
        "TableName": "${token_table_name}",
        "Key": {
          "commandId": {
            "S.$": "$$.Execution.Id"
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultPath": "$.command_mapping",
      "Next": "GetTimedOutCommandInvocation"
    },
    "GetTimedOutCommandInvocation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:getCommandInvocation",
      "Parameters": {
        "CommandId.$": "$.command_mapping.Item.mappedCommandId.S",
        "InstanceId.$": "$.command_mapping.Item.instanceId.S"
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultPath": "$.command_invocation",
      "Next": "ClassifyTimedOutCommand"
    },
    "ClassifyTimedOutCommand": {
      "Type": "Choice",
      "Choices": [
        {
          "Or": [
            {
              "Variable": "$.command_invocation.Status",
              "StringEquals": "Pending"
            },
            {
              "Variable": "$.command_invocation.Status",
              "StringEquals": "InProgress"
            },
            {
              "Variable": "$.command_invocation.Status",
              "StringEquals": "Delayed"
            },
            {
              "Variable": "$.command_invocation.Status",
              "StringEquals": "Cancelling"
            }
          ],
          "Next": "CancelTimedOutCommand"
        }
      ],
      "Default": "IsTimedOutCommandSuccess"
    },
    "IsTimedOutCommandSuccess": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.command_invocation.ResponseCode",
          "NumericEquals": 0,
          "Next": "Succeeded"
        }
      ],
      "Default": "Failed"
    },
    "CancelTimedOutCommand": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:cancelCommand",
      "Parameters": {
        "CommandId.$": "$.command_mapping.Item.mappedCommandId.S",
        "InstanceIds.$": "States.Array($.command_mapping.Item.instanceId.S)"
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "TimedOut"
    },
    "TimedOut": {
      "Type": "Fail",
      "Error": "SsmCommandTimedOut",
      "Cause": "Remote command was still running after the callback deadline and was cancelled"
    },
    "IsSuccess": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.callback.exit_code",
          "NumericEquals": 0,
          "Next": "Succeeded"
        }
      ],
      "Default": "Failed"
    },
    "Succeeded": {
      "Type": "Succeed"
    },
    "Failed": {
      "Type": "Fail",
      "Error": "SsmCommandFailed",
      "Cause": "Remote command reported a non-zero exit_code via the task-token callback"
    }
  }
}
