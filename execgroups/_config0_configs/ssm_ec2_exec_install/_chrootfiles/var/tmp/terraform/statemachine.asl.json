{
  "Comment": "ssm_ec2_exec — run a payload on an EC2 instance via SSM Run Command, waiting on a task-token callback from the remote wrapper instead of polling.",
  "StartAt": "ApplyDefaults",
  "States": {
    "ApplyDefaults": {
      "Type": "Pass",
      "Parameters": {
        "input.$": "$",
        "defaults": {
          "timeout_seconds": 3600
        }
      },
      "Next": "Merge"
    },
    "Merge": {
      "Type": "Pass",
      "Parameters": {
        "merged.$": "States.JsonMerge($.defaults, $.input, false)"
      },
      "Next": "ComputeCallbackTimeout"
    },
    "ComputeCallbackTimeout": {
      "Type": "Pass",
      "Comment": "Callback bound (ASL Task TimeoutSecondsPath) = requested execution timeout + 300s grace, so a lost callback still goes terminal instead of hanging indefinitely.",
      "Parameters": {
        "merged": {
          "instance_id.$": "$.merged.instance_id",
          "script.$": "$.merged.script",
          "timeout_seconds.$": "$.merged.timeout_seconds",
          "callback_timeout_seconds.$": "States.MathAdd($.merged.timeout_seconds, 300)"
        }
      },
      "Next": "SendCommand"
    },
    "SendCommand": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:sendCommand.waitForTaskToken",
      "Parameters": {
        "DocumentName": "AWS-RunShellScript",
        "InstanceIds.$": "States.Array($.merged.instance_id)",
        "TimeoutSeconds.$": "$.merged.timeout_seconds",
        "Parameters": {
          "commands.$": "States.Array(States.Format('export TASK_TOKEN=\"{}\"', $$.Task.Token), $.merged.script)",
          "executionTimeout.$": "States.Array(States.Format('{}', $.merged.timeout_seconds))"
        },
        "CloudWatchOutputConfig": {
          "CloudWatchLogGroupName": "${ssm_log_group_name}",
          "CloudWatchOutputEnabled": true
        },
        "OutputS3BucketName": "${bucket_name}",
        "OutputS3KeyPrefix": "native-output"
      },
      "TimeoutSecondsPath": "$.merged.callback_timeout_seconds",
      "ResultPath": "$.callback",
      "Next": "IsSuccess"
    },
    "IsSuccess": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.callback.exit_code",
          "NumericEquals": 0,
          "Next": "Succeeded"
        }
      ],
      "Default": "Failed"
    },
    "Succeeded": {
      "Type": "Succeed"
    },
    "Failed": {
      "Type": "Fail",
      "Error": "SsmCommandFailed",
      "Cause": "Remote command reported a non-zero exit_code via the task-token callback"
    }
  }
}
